{% extends 'base.html.twig' %}

{% block title %}Modifier
	{{ client.name }}
{% endblock %}

{% block body %}
	<div
		class="flex h-screen bg-[#F8FAFC] font-sans">

		{# Sidebar #}
		<twig:Sidebar/>

		{# Contenu principal centré #}
		<main class="flex-1 overflow-y-auto p-8 flex items-center justify-center">

			<div
				class="bg-white rounded-2xl shadow-sm border border-gray-100 w-full max-w-md p-8 relative">

				{# Croix de fermeture pour annuler #}
				<a href="{{ path('app_client_index') }}" class="absolute top-6 right-6 text-gray-400 hover:text-gray-600 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</a>

				{# En-tête #}
				<div class="mb-6">
					<h1 class="text-xl font-bold text-gray-900">Client -
						{{ client.name }}</h1>
					<p class="text-sm text-gray-500 mt-1">Modifier le client</p>
				</div>

				{# Formulaire #}
				{{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

				{# Nom #}
				<div>
					<label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">Nom du client / Entreprise</label>
					{{ form_widget(form.name, {'attr': {'class': 'w-full bg-white border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all'}}) }}
				</div>

				{# Email #}
				<div>
					<label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">Email</label>
					{{ form_widget(form.email, {'attr': {'class': 'w-full bg-white border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all'}}) }}
				</div>

				{# Téléphone #}
				<div>
					<label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">Téléphone</label>
					{{ form_widget(form.phone, {'attr': {'class': 'w-full bg-white border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all'}}) }}
				</div>

				{# Adresse #}
				<div>
					<label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">Adresse</label>
					{{ form_widget(form.address, {'attr': {'class': 'w-full bg-white border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all'}}) }}
				</div>

				{# SIRET (optionnel) #}
				<div>
					<label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">SIRET (Optionnel)</label>
					{{ form_widget(form.siret, {'attr': {'class': 'w-full bg-white border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all'}}) }}
				</div>

				{# RIB (optionnel) #}
				<div>
					<label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">RIB (Optionnel)</label>
					{{ form_widget(form.rib, {'attr': {'class': 'w-full bg-white border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all'}}) }}
				</div>

				{# Boutons d'action #}
				<div class="flex justify-end gap-3 pt-6">
					<a href="{{ path('app_client_index') }}" class="px-6 py-2.5 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-all">
						Annuler
					</a>
					<button type="submit" class="px-6 py-2.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-all">
						Enregistrer
					</button>
				</div>

				{{ form_end(form) }}
			</main>
		</div>
	{% endblock %}
