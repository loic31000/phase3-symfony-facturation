{% extends 'base.html.twig' %}
{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="flex h-screen bg-[#F8FAFC] font-sans">
    <twig:Sidebar />



    {# Main content #}
    <main class="flex-1 overflow-y-auto p-8 lg:p-10">
        <h1 class="text-[28px] font-bold text-gray-900 mb-8">Dashboard</h1>

        {# KPI Cards (Haut) - Utilisation de Grid au lieu de largeurs fixes #}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            
            <div class="bg-white rounded-[14px] border border-gray-100 shadow-sm p-6 flex flex-col gap-4">
                <div class="w-12 h-12 rounded-xl bg-green-50 text-green-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M12 16v-8"/><path d="M9 10h5a2 2 0 1 1 0 4h-4a2 2 0 1 0 0 4h5"/></svg>
                </div>
                <div>
                    <p class="text-sm text-gray-500 mb-1">Chiffre d'affaires (Payé)</p>
                    <p class="text-3xl font-bold text-gray-900">{{ stats.revenue|default(2250)|number_format(0, ',', ' ') }} €</p>
                </div>
            </div>
            
            <div class="bg-white rounded-[14px] border border-gray-100 shadow-sm p-6 flex flex-col gap-4">
                <div class="w-12 h-12 rounded-xl bg-orange-50 text-orange-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                </div>
                <div>
                    <p class="text-sm text-gray-500 mb-1">Factures en attente de paiement</p>
                    <p class="text-3xl font-bold text-gray-900">{{ stats.pendingInvoices|default(1) }}</p>
                </div>
            </div>
            
            <div class="bg-white rounded-[14px] border border-gray-100 shadow-sm p-6 flex flex-col gap-4">
                <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div>
                    <p class="text-sm text-gray-500 mb-1">Total Clients</p>
                    <p class="text-3xl font-bold text-gray-900">{{ stats.totalClients|default(2) }}</p>
                </div>
            </div>
            
            <div class="bg-white rounded-[14px] border border-gray-100 shadow-sm p-6 flex flex-col gap-4">
                <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                </div>
                <div>
                    <p class="text-sm text-gray-500 mb-1">Total Produits</p>
                    <p class="text-3xl font-bold text-gray-900">{{ stats.totalProducts|default(3) }}</p>
                </div>
            </div>
        </div>

        {# Chart Section #}
        <div class="bg-white rounded-[14px] border border-gray-100 shadow-sm p-6 mb-8">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-lg font-bold text-gray-900">Chiffre d'affaires mensuel (Factures payées)</h2>
                <select class="text-sm border border-gray-200 rounded-lg px-4 py-2 text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 appearance-none bg-white cursor-pointer pr-8 relative">
                    <option>2023</option>
                    <option>2024</option>
                    <option>2025</option>
                </select>
            </div>
            
            <div class="h-80">
                <canvas id="revenueChart" class="w-full h-full"></canvas>
            </div>
        </div>

        {# Quick Actions (Bas) - Séparation de la grille des 3 actions et du bouton relance #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
            <a href="#" class="bg-blue-50 border border-blue-100 rounded-[14px] p-6 hover:bg-blue-100 transition-colors group flex items-center justify-between">
                <div>
                    <p class="text-base font-bold text-blue-900 mb-1">Créer une facture</p>
                    <p class="text-sm text-blue-600">Nouvelle prestation</p>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500 shrink-0 transform group-hover:translate-x-1 transition-transform">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
            </a>
            
            <a href="#" class="bg-white border border-gray-100 shadow-sm rounded-[14px] p-6 hover:border-gray-300 transition-colors group flex items-center justify-between">
                <div>
                    <p class="text-base font-bold text-gray-900 mb-1">Ajouter un client</p>
                    <p class="text-sm text-gray-500">Gérer le répertoire</p>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 shrink-0 transform group-hover:translate-x-1 transition-transform">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
            </a>
            
            <a href="#" class="bg-white border border-gray-100 shadow-sm rounded-[14px] p-6 hover:border-gray-300 transition-colors group flex items-center justify-between">
                <div>
                    <p class="text-base font-bold text-gray-900 mb-1">Créer un produit / service</p>
                    <p class="text-sm text-gray-500">Enrichir le catalogue</p>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 shrink-0 transform group-hover:translate-x-1 transition-transform">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
            </a>
        </div>

        {# Relancer tous les clients - Placé en dessous des actions rapides #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div x-data="{ open: false }" class="relative col-span-1">
                <button @click="open = !open" class="w-full bg-white border border-gray-100 shadow-sm rounded-[14px] p-6 hover:border-gray-300 transition-colors group flex items-center justify-between">
                    <div class="text-left">
                        <p class="text-base font-bold text-gray-900 mb-1">Relancer tous les clients</p>
                        <p class="text-sm text-gray-500">Envoyer un mail aux clients en retard</p>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 shrink-0 transform group-hover:translate-x-1 transition-transform">
                        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                    </svg>
                </button>
                
                {# Sous-options de relance - Reste inchangé #}
                <div x-show="open" @click.away="open = false" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 transform -translate-y-2" x-transition:enter-end="opacity-100 transform translate-y-0" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 transform translate-y-0" x-transition:leave-end="opacity-0 transform -translate-y-2" class="absolute z-10 bottom-full mb-2 w-full bg-white rounded-xl border border-gray-200 shadow-xl overflow-hidden" style="display: none;">
                    <div class="py-2">
                        <button onclick="relanceClient('tous')" class="w-full text-left px-4 py-3 hover:bg-gray-50 transition-colors border-b border-gray-100">
                            <p class="text-sm font-medium text-gray-900">📧 Relancer tous les clients</p>
                            <p class="text-xs text-gray-500 mt-0.5">Envoyer un mail à tous les concernés</p>
                        </button>
                        </div>
                </div>
            </div>
        </div>
        
        {# Zone de notification #}
        <div id="notificationRelance" class="fixed bottom-4 right-4 z-50 transition-opacity duration-300" style="display: none; opacity: 0;">
            <div class="bg-gray-900 text-white px-6 py-3 rounded-lg shadow-xl flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span id="notificationMessage" class="text-sm font-medium"></span>
            </div>
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="//unpkg.com/alpinejs" defer></script>
<script>
    // Notifications logic
    function relanceClient(type) {
        let message = 'Relance envoyée avec succès';
        // Ta logique switch ici...

        const notification = document.getElementById('notificationRelance');
        const messageSpan = document.getElementById('notificationMessage');
        
        messageSpan.textContent = message;
        notification.style.display = 'block';
        
        // Fade in
        setTimeout(() => notification.style.opacity = '1', 10);
        
        setTimeout(() => {
            notification.style.opacity = '0';
            setTimeout(() => notification.style.display = 'none', 300);
        }, 3000);
        
        const dropdown = document.querySelector('[x-data]');
        if (dropdown && dropdown.__x) dropdown.__x.$data.open = false;
    }
    
    // Chart logic
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('revenueChart').getContext('2d');
        // J'ai mis à 0 les autres mois pour coller à ta maquette où seul Mars apparaît
        const monthlyData = [0, 0, 2250, 0, 0, 0, 0, 0, 0, 0, 0, 0]; 
        
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'],
                datasets: [{
                    data: monthlyData,
                    backgroundColor: '#3b82f6',
                    hoverBackgroundColor: '#2563eb',
                    borderRadius: 4,
                    borderSkipped: false,
                    barThickness: 40,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1f2937',
                        padding: 12,
                        callbacks: {
                            label: function(context) { return context.raw + ' €'; }
                        }
                    }
                },
                scales: {
                    x: { 
                        grid: { display: false, drawBorder: false },
                        ticks: { font: { size: 12 }, color: '#9ca3af' }
                    },
                    y: {
                        grid: { color: '#f3f4f6', drawBorder: false, borderDash: [5, 5] },
                        min: 0,
                        max: 2400,
                        ticks: {
                            stepSize: 600,
                            font: { size: 12 },
                            color: '#9ca3af',
                            callback: function(v) { return v + '€'; }
                        }
                    }
                }
            }
        });
    });
</script>
{% endblock %}