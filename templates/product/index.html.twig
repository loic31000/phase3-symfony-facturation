{% extends 'base.html.twig' %}


{% block title %}Produits & Services{% endblock %}

{% block body %}
<div class="flex min-h-screen bg-[#F8FAFC] font-sans">

    {# 1. Sidebar à gauche #}
    <twig:Sidebar />

    {# 2. Contenu principal #}
    <main class="flex-1 overflow-y-auto p-8 lg:p-10">
        
        <div class="max-w-6xl mx-auto">
            
            {# En-tête : Titre à gauche, Bouton à droite #}
            <div class="flex items-center justify-between mb-8">
                <h1 class="text-2xl font-bold text-gray-900">Produits & Services</h1>
                
                {# Le fameux bouton qui mène vers la page d'ajout #}
                <a href="{{ path('app_product_new') }}" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-[#2563EB] hover:bg-blue-700 rounded-lg transition-colors shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    Ajouter un produit
                </a>
            </div>

            {# Messages Flash pour les succès (ex: "Produit ajouté avec succès") #}
            {% for message in app.flashes('success') %}
                <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6 w-full">
                    {{ message }}
                </div>
            {% endfor %}

            {# Tableau des produits #}
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden w-full">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-white border-b border-gray-100">
                        <tr>
                            <th class="px-6 py-4 text-xs font-bold text-gray-900">Nom</th>
                            <th class="px-6 py-4 text-xs font-bold text-gray-900">Description</th>
                            <th class="px-6 py-4 text-xs font-bold text-gray-900">Prix unitaire</th>
                            <th class="px-6 py-4 text-xs font-bold text-gray-900 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for product in products %}
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="px-6 py-4 text-sm text-gray-800">{{ product.name }}</td>
                                <td class="px-6 py-4 text-sm text-gray-500">{{ product.description|default('-')|slice(0, 80) }}</td>
                                <td class="px-6 py-4 text-sm text-gray-800">
                                    {{ product.price|number_format(2, ',', ' ') }} € / {{ product.unit.value }}
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex justify-end items-center gap-3">
                                        {# Icône Modifier #}
                                        <a href="{{ path('app_product_edit', {id: product.id}) }}" class="text-blue-500 hover:text-blue-700 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                        </a>
                                        {# Icône Supprimer #}
                                        <form method="post" action="{{ path('app_product_delete', {id: product.id}) }}" onsubmit="return confirm('Supprimer ce produit ?');" class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                            <button type="submit" class="text-red-500 hover:text-red-700 transition-colors">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="px-6 py-8 text-center text-sm text-gray-400">
                                    Aucun produit n'a été créé pour le moment.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        </div>
    </main>
</div>
{% endblock %}