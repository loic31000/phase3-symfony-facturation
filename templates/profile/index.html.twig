{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="flex min-h-screen bg-[#F8F9FB] font-sans">
    
    <twig:Sidebar />

    <main class="flex-1 p-8 lg:p-10">
        
        <div class="max-w-2xl">
            <h1 class="text-2xl font-bold text-[#1E293B] mb-8">Mon Profil</h1>

            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-8">
                
                {% for message in app.flashes('success') %}
                    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
                        {{ message }}
                    </div>
                {% endfor %}

                {{ form_start(profileForm, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}
          
                    <div>
                        {{ form_label(profileForm.company_name, 'Raison Sociale', {'label_attr': {'class': 'block text-sm font-medium text-gray-500 mb-2'}}) }}
                        {{ form_widget(profileForm.company_name, {'attr': {'class': 'w-full border border-gray-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                        <p class="text-xs text-gray-400 mt-2">Le nom de votre entreprise qui apparaîtra sur vos factures.</p>
                    </div>
                    
                    <div>
                        {{ form_label(profileForm.siret, 'Numéro SIRET (Optionnel)', {'label_attr': {'class': 'block text-sm font-medium text-gray-500 mb-2'}}) }}
                        {{ form_widget(profileForm.siret, {'attr': {'class': 'w-full border border-gray-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                    </div>

                    <div>
                        {{ form_label(profileForm.iban, 'IBAN', {'label_attr': {'class': 'block text-sm font-medium text-gray-500 mb-2'}}) }}
                        {{ form_widget(profileForm.iban, {'attr': {'class': 'w-full border border-gray-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                        <p class="text-xs text-gray-400 mt-2">Compte bancaire qui recevra les virements de vos clients.</p>
                    </div>

                    <div>
                        {{ form_label(profileForm.cgv, 'Conditions Générales de Vente (CGV)', {'label_attr': {'class': 'block text-sm font-medium text-gray-500 mb-2'}}) }}
                        {{ form_widget(profileForm.cgv, {'attr': {
                            'class': 'w-full border border-gray-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500',
                            'rows': 4,
                            'placeholder': 'Ces conditions apparaîtront en bas de vos factures PDF...'
                        }}) }}
                    </div>

                    <div class="pt-4">
                        <button type="submit" class="bg-[#2563EB] hover:bg-blue-700 text-white font-medium py-2.5 px-6 rounded-lg transition-colors shadow-sm">
                            Enregistrer les modifications
                        </button>
                    </div>

                {{ form_end(profileForm) }}
            </div>
        </div>
    </main>
</div>
{% endblock %}